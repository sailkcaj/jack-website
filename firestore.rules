rules_version = '2';

// Public read so anyone visiting sailkcaj.com sees the Time tab's data live.
// Write requires being signed in — the Firebase console only has the one
// editor account Jack creates (see README.md's "Time tab storage" section),
// so this is the actual write protection, not anything in the client code.
service cloud.firestore {
  match /databases/{database}/documents {
    match /timeData/{docId} {
      allow read: if true;
      allow write: if request.auth != null;
    }
  }
}
