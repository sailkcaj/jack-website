rules_version = '2';

// Only Jack's existing Firebase account can read or change Time data.
// Keep this UID in sync with src/ownerIdentity.js.
service cloud.firestore {
  match /databases/{database}/documents {
    match /timeData/{docId} {
      allow read, write: if request.auth != null
        && request.auth.uid == 'Tqvyw7Vqa9fEuJieoBJSuVC358o2';
    }
  }
}
